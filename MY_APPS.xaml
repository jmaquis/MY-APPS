<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MY APPS" Width="1160" Height="740" MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#121420" Foreground="#F2F3FA" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#F2F3FA" />
    <SolidColorBrush x:Key="Muted" Color="#AEB3CA" />
    <SolidColorBrush x:Key="Accent" Color="#C5B8FF" />
    <Style x:Key="Action" TargetType="Button">
      <Setter Property="Background" Value="#24263A" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="BorderBrush" Value="#383C56" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#B9A9FF" />
                <Setter TargetName="Surface" Property="Opacity" Value=".88" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#DDD3FF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value=".66" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
      <Setter Property="Background" Value="#C5B8FF" />
      <Setter Property="Foreground" Value="#21174A" />
      <Setter Property="BorderBrush" Value="#D1C6FF" />
    </Style>
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinHeight" Value="43" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Surface" Background="Transparent" CornerRadius="10" BorderThickness="1"
                    BorderBrush="Transparent" Padding="11,0">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#232539" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#2B2546" />
                <Setter TargetName="Surface" Property="BorderBrush" Value="#403459" />
                <Setter Property="Foreground" Value="#DBCFFF" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#DDD3FF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WindowButton" TargetType="Button">
      <Setter Property="Width" Value="45" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#2F3248" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#333650" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="AppCard">
      <Border Width="258" Margin="0,0,13,13" Padding="15" Background="#1C1F30"
              BorderBrush="#343750" BorderThickness="1" CornerRadius="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="43" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="43" Height="43" Background="{Binding [IconBackground]}" CornerRadius="12">
              <Path Width="17" Height="17" Stretch="Uniform" Data="{Binding [IconGeometry]}" Stroke="{Binding [IconStroke]}"
                    StrokeThickness="1.6" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding [Kind]}" Margin="10,0,0,0" Foreground="{StaticResource Muted}"
                       FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </Grid>
          <StackPanel Grid.Row="1" Margin="0,13,0,13">
            <TextBlock Text="{Binding [Name]}" ToolTip="{Binding [Name]}" FontSize="17" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding [Detail]}" ToolTip="{Binding [Path]}" Foreground="{StaticResource Muted}"
                       Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Visibility="{Binding [InstalledActions]}">
            <Button Content="Ouvrir" Tag="Open" Style="{StaticResource Primary}" MinWidth="76"
                    AutomationProperties.Name="{Binding [OpenAccessibleName]}" />
            <Button Content="Supprimer" Tag="Remove" Style="{StaticResource Action}" MinWidth="76"
                    Margin="7,0,0,0"
                    AutomationProperties.Name="{Binding [RemoveAccessibleName]}" />
          </StackPanel>
          <Button Grid.Row="3" Tag="DownloadApp" Content="{Binding [GitHubActionLabel]}"
                  Style="{StaticResource Action}" HorizontalAlignment="Left" Margin="0,7,0,0"
                  Visibility="{Binding [GitHubActionVisibility]}" AutomationProperties.Name="{Binding [GitHubActionName]}" />
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid x:Name="WindowLayout">
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="*" />
      <RowDefinition Height="36" />
    </Grid.RowDefinitions>
    <Border Background="#141624" BorderBrush="#26283A" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="19,0,0,0">
          <Border Width="22" Height="22" Background="#C5B8FF" CornerRadius="6">
            <Path Width="12" Height="12" Stretch="Uniform" Stroke="#2A1F50" StrokeThickness="1.5"
                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="M1,9 L1,1 5,5 9,1 9,9" />
          </Border>
          <TextBlock Text="MY APPS" Margin="10,0,0,0" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}" ToolTip="Réduire"
                  AutomationProperties.Name="Réduire">
            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M 0,5 H 10" />
          </Button>
          <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" ToolTip="Agrandir ou restaurer"
                  AutomationProperties.Name="Agrandir ou restaurer">
            <Path x:Name="MaximizeIcon" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M 0,0 H 9 V 9 H 0 Z" />
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource WindowButton}" ToolTip="Fermer"
                  AutomationProperties.Name="Fermer">
            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M 0,0 L 9,9 M 9,0 L 0,9" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="#161826" BorderBrush="#282A3D" BorderThickness="0,0,1,0" Padding="14,29,14,12">
        <StackPanel>
          <TextBlock Text="BIBLIOTHÈQUE" Foreground="{StaticResource Muted}" FontSize="11"
                     FontWeight="SemiBold" Margin="12,0,0,13" />
          <RadioButton x:Name="AllNav" GroupName="Catalog" IsChecked="True" Style="{StaticResource Nav}" AutomationProperties.Name="Toutes les applis">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                    Data="M0,0 H6 V6 H0 Z M9,0 H15 V6 H9 Z M0,9 H6 V15 H0 Z M9,9 H15 V15 H9 Z" />
              <TextBlock Text="Toutes les applis" Margin="10,0,0,0" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="PackNav" GroupName="Catalog" Style="{StaticResource Nav}" AutomationProperties.Name="Applications locales">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                    Data="M7.5,0 L15,4 15,12 7.5,16 0,12 0,4 Z M0,4 L7.5,8 15,4 M7.5,8 V16" />
              <TextBlock Text="Applications locales" Margin="10,0,0,0" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="LinkNav" GroupName="Catalog" Style="{StaticResource Nav}" AutomationProperties.Name="Raccourcis">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                    Data="M7,2 H2 V14 H14 V9 M9,1 H15 V7 M15,1 L7,9" />
              <TextBlock Text="Raccourcis" Margin="10,0,0,0" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="GitHubNav" GroupName="Catalog" Style="{StaticResource Nav}"
                       AutomationProperties.Name="Catalogue GitHub">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                    Data="M1,7 V12 H13 V7 M7,8 V0 M4,5 L7,8 10,5" />
              <TextBlock Text="Catalogue GitHub" Margin="10,0,0,0" />
              <TextBlock x:Name="GitHubCount" Margin="6,0,0,0" Foreground="{StaticResource Accent}"
                         FontWeight="Bold" Visibility="Collapsed" />
            </StackPanel>
          </RadioButton>
          <Button x:Name="UpdateButton" Content="Mettre à jour MY APPS" Style="{StaticResource Action}"
                  Margin="0,18,0,0" ToolTip="Installer un ZIP de mise à jour du launcher" />
          <TextBlock x:Name="LauncherVersion" Foreground="{StaticResource Muted}" FontSize="11"
                     Margin="12,8,0,0" />
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Margin="26,24,26,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border CornerRadius="18" BorderThickness="1" BorderBrush="#494060">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#30254D" Offset="0" />
              <GradientStop Color="#26243F" Offset=".55" />
              <GradientStop Color="#1C2034" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid ClipToBounds="True">
            <Canvas Width="185" HorizontalAlignment="Right" VerticalAlignment="Stretch" IsHitTestVisible="False" Opacity=".34">
              <Ellipse Width="234" Height="234" Canvas.Left="5" Canvas.Top="-83" Stroke="#AA91EB" />
              <Ellipse Width="202" Height="202" Canvas.Left="21" Canvas.Top="-67" Stroke="#AA91EB" />
              <Ellipse Width="168" Height="168" Canvas.Left="38" Canvas.Top="-50" Stroke="#AA91EB" />
              <Ellipse Width="134" Height="134" Canvas.Left="55" Canvas.Top="-33" Stroke="#AA91EB" />
              <Ellipse Width="9" Height="9" Canvas.Left="26" Canvas.Top="81" Fill="#C5B8FF" />
            </Canvas>
            <StackPanel Margin="23,17,23,19" HorizontalAlignment="Left">
              <TextBlock x:Name="PageTitle" Text="Mes applications" FontSize="30" FontWeight="Bold"
                         TextOptions.TextFormattingMode="Display" />
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="ImportButton" Style="{StaticResource Primary}" Margin="0,0,9,0" AutomationProperties.Name="Importer un pack ZIP">
                  <StackPanel Orientation="Horizontal">
                    <Path Margin="0,0,8,0" VerticalAlignment="Center" Stroke="#24194D" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 1,7 V 11 H 13 V 7 M 7,8 V 0 M 4,5 L 7,8 10,5" />
                    <TextBlock Text="Importer un pack ZIP" />
                  </StackPanel>
                </Button>
                <Button x:Name="AddButton" Style="{StaticResource Action}" AutomationProperties.Name="Ajouter un fichier"
                        ToolTip="Copier un fichier HTML autonome ou créer un raccourci vers un EXE">
                  <StackPanel Orientation="Horizontal">
                    <Path Margin="0,0,8,0" VerticalAlignment="Center" Stroke="{StaticResource Ink}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 1,6 H 11 M 6,1 V 11" />
                    <TextBlock Text="Ajouter un fichier" />
                  </StackPanel>
                </Button>
                <Button x:Name="RefreshCatalogButton" Content="Actualiser" Style="{StaticResource Action}"
                        Margin="9,0,0,0" Visibility="Collapsed" />
              </StackPanel>
              <Button x:Name="GitHubAlertButton" Style="{StaticResource Action}" Margin="0,9,0,0"
                      HorizontalAlignment="Left" Visibility="Collapsed" ToolTip="Ouvrir le catalogue GitHub" />
              <TextBlock x:Name="GitHubStatus" Margin="0,9,0,0" Visibility="Collapsed"
                         Foreground="{StaticResource Muted}" FontSize="12" />
            </StackPanel>
          </Grid>
        </Border>
        <DockPanel Grid.Row="1" Margin="0,18,0,14" LastChildFill="False">
          <TextBlock x:Name="AppCount" DockPanel.Dock="Left" Foreground="{StaticResource Muted}"
                     VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
          <Border DockPanel.Dock="Right" Width="230" Height="38" CornerRadius="9"
                  Background="#1C1F31" BorderBrush="#383B54" BorderThickness="1">
            <Grid>
              <Path HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"
                    Stroke="{StaticResource Muted}" StrokeThickness="1.5" Data="M 10,5 A 5,5 0 1 1 0,5 A 5,5 0 1 1 10,5 M 9,9 L 13,13" />
              <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Ink}"
                       CaretBrush="{StaticResource Ink}" FontSize="13" Padding="0,0,7,0" Margin="33,0,0,0"
                       VerticalContentAlignment="Center" AutomationProperties.Name="Rechercher une application" />
              <TextBlock x:Name="SearchHint" Text="Rechercher une application" Foreground="{StaticResource Muted}"
                         FontSize="12" VerticalAlignment="Center" Margin="33,0,6,0" IsHitTestVisible="False" />
            </Grid>
          </Border>
        </DockPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid>
            <ItemsControl x:Name="AppsGrid" ItemTemplate="{StaticResource AppCard}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Border x:Name="EmptyState" Background="#191C2D" BorderBrush="#32354C" BorderThickness="1"
                    CornerRadius="14" Padding="20" VerticalAlignment="Top" Margin="0,0,8,14">
              <StackPanel>
                <TextBlock x:Name="EmptyTitle" Foreground="{StaticResource Ink}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="EmptyBody" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#151725" BorderBrush="#282A3D" BorderThickness="0,1,0,0" Padding="20,0">
      <DockPanel LastChildFill="True">
        <Ellipse Width="7" Height="7" Fill="#A9E3C8" VerticalAlignment="Center" Margin="0,0,9,0" />
        <TextBlock x:Name="StatusText" Text="Sur cet ordinateur" Foreground="{StaticResource Muted}"
                   VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
